@model List<EntryDto>
@{
    ViewData["Title"] = "My enrolments";
}
<div class="container page">
    <div class="page-head">
        <div>
            <h1>My enrolments</h1>
            <p>Every event you've entered and where each enrolment stands.</p>
        </div>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Find an event</a>
    </div>

    <partial name="_Flash" />

    @if (Model.Count == 0)
    {
        <div class="panel empty">
            <h3>You haven't enrolled in anything yet</h3>
            <p>Browse upcoming events, pick a category and your enrolment will show up here.</p>
            <a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index">Browse events</a>
        </div>
    }
    else
    {
        <div class="panel panel--flush">
            <table class="rd-table table-responsive-stack">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Category</th><th>Enrolled on</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var entry in Model)
                {
                    <tr>
                        <td data-label="Event">
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@entry.EventId"><b>@entry.EventName</b></a><br />
                            <span class="text-muted small">@entry.EventLocation</span>
                        </td>
                        <td data-label="Date">@ViewHelpers.ShortDate(entry.EventDate)</td>
                        <td data-label="Category">@entry.CategoryName</td>
                        <td data-label="Enrolled on">@ViewHelpers.ShortDate(entry.EntryDate)</td>
                        <td data-label="Status"><partial name="_StatusBadge" model="@entry.Status" /></td>
                        <td>
                            <div class="row-actions">
                                @if (entry.CanWithdraw)
                                {
                                    <form asp-action="Withdraw" method="post" data-confirm="@($"Cancel your enrolment in {entry.EventName}?")">
                                        <input type="hidden" name="entryId" value="@entry.EntryId" />
                                        <button type="submit" class="btn btn-sm btn-danger-quiet">Cancel enrolment</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
