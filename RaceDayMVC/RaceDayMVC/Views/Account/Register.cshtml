@model RegisterViewModel
@{
    ViewData["Title"] = "Sign up";
}
<div class="container page">
    <div class="form-narrow" style="max-width:600px">
        <h1 class="mb-4">Create your account</h1>
        <form asp-action="Register" method="post" class="panel" novalidate>
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert-form" role="alert" asp-validation-summary="ModelOnly"></div>
            }
            <fieldset class="mb-4">
                <legend class="form-label">I want to</legend>
                <div class="choice">
                    <label>
                        <input type="radio" name="Role" value="Participant" checked="@(Model.Role == "Participant")" />
                        <b>Enter races</b>
                        <small>Browse events, enrol and see your results.</small>
                    </label>
                    <label>
                        <input type="radio" name="Role" value="Organiser" checked="@(Model.Role == "Organiser")" />
                        <b>Organise races</b>
                        <small>Create events, manage enrolments and publish results.</small>
                    </label>
                </div>
                <span asp-validation-for="Role"></span>
            </fieldset>

            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="FirstName"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="LastName"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" type="tel" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber"></span>
            </div>

            <div id="organiserFields" class="mb-3">
                <label asp-for="OrganiserAccessCode" class="form-label"></label>
                <input asp-for="OrganiserAccessCode" class="form-control" autocomplete="off" />
                <div class="form-hint">Organiser accounts need the access code issued by RaceDay.</div>
                <span asp-validation-for="OrganiserAccessCode"></span>
            </div>

            <div id="participantFields" class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label asp-for="DateOfBirth" class="form-label"></label>
                    <input asp-for="DateOfBirth" class="form-control" type="date" />
                    <span asp-validation-for="DateOfBirth"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Gender" class="form-label"></label>
                    <select asp-for="Gender" class="form-select">
                        <option value="">Choose</option>
                        @foreach (var gender in FormOptions.Genders)
                        {
                            <option value="@gender" selected="@(Model.Gender == gender)">@gender</option>
                        }
                    </select>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100">Create account</button>
        </form>
        <p class="mt-3 text-center">Already have an account? <a asp-action="Login">Log in</a></p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
