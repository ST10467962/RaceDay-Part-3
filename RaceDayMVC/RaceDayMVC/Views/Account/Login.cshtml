@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
}
<div class="container page">
    <div class="form-narrow">
        <h1 class="mb-4">Log in</h1>
        <partial name="_Flash" />
        <form asp-action="Login" method="post" class="panel" novalidate>
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert-form" role="alert" asp-validation-summary="ModelOnly"></div>
            }
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Log in</button>
        </form>
        <p class="mt-3 text-center">New to RaceDay? <a asp-action="Register">Create an account</a></p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
