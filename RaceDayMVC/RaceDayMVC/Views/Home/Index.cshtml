@model EventListViewModel
@{
    ViewData["Title"] = "Upcoming events";
    var filter = Model.Filter;
}
<div class="container page">
    <div class="page-head">
        <div>
            <h1>Upcoming events</h1>
            <p>Find a start line and enrol in the category that suits you.</p>
        </div>
    </div>

    <partial name="_Flash" />

    <form method="get" asp-action="Index" class="filter-bar" aria-label="Filter events">
        <div class="row g-3 align-items-end">
            <div class="col-lg-3 col-md-6">
                <label for="Search" class="form-label">Search</label>
                <input id="Search" name="Search" class="form-control" value="@filter.Search" placeholder="Name or place" />
            </div>
            <div class="col-lg-2 col-md-6">
                <label for="EventType" class="form-label">Type</label>
                <select id="EventType" name="EventType" class="form-select">
                    <option value="">All types</option>
                    @foreach (var type in FormOptions.EventTypes)
                    {
                        <option value="@type" selected="@(filter.EventType == type)">@type</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-6">
                <label for="MinDistance" class="form-label">Min km</label>
                <input id="MinDistance" name="MinDistance" type="number" step="0.1" min="0" class="form-control" value="@filter.MinDistance" />
            </div>
            <div class="col-lg-2 col-6">
                <label for="MaxDistance" class="form-label">Max km</label>
                <input id="MaxDistance" name="MaxDistance" type="number" step="0.1" min="0" class="form-control" value="@filter.MaxDistance" />
            </div>
            <div class="col-lg-3 col-md-6">
                <label for="DateFrom" class="form-label">From</label>
                <input id="DateFrom" name="DateFrom" type="date" class="form-control" value="@(filter.DateFrom?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-lg-3 col-md-6">
                <label for="DateTo" class="form-label">To</label>
                <input id="DateTo" name="DateTo" type="date" class="form-control" value="@(filter.DateTo?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-lg-9 d-flex gap-2 justify-content-lg-end">
                <button type="submit" class="btn btn-primary">Apply filters</button>
                @if (Model.HasFilter)
                {
                    <a class="btn btn-outline-ink" asp-action="Index">Clear</a>
                }
            </div>
        </div>
    </form>

    @if (Model.Events.Count == 0)
    {
        <div class="panel empty">
            <h3>@(Model.HasFilter ? "No events match those filters" : "No upcoming events yet")</h3>
            <p>@(Model.HasFilter ? "Widen the distance or date range, or clear the filters to see everything." : "Check back soon. Organisers are adding events all the time.")</p>
            @if (Model.HasFilter)
            {
                <a class="btn btn-primary mt-2" asp-action="Index">Clear filters</a>
            }
        </div>
    }
    else
    {
        <div class="bib-grid">
            @foreach (var ev in Model.Events)
            {
                <partial name="_EventBib" model="ev" />
            }
        </div>
    }
</div>
