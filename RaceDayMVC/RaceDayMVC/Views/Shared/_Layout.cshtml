@{
    var user = Context.Session.GetUser();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(params string[] names) => names.Contains(controller, StringComparer.OrdinalIgnoreCase) ? " active" : "";
    var avatarUrl = user == null ? null : Url.ImageUrl(user.ProfilePictureName);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] == null ? "RaceDay" : ViewData["Title"] + " | RaceDay")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg rd-nav">
        <div class="container">
            <a class="rd-brand" asp-controller="Home" asp-action="Index" aria-label="RaceDay home">
                <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="6" fill="#ffd60a"/><path d="M6 22 L16 8 L26 22 M6 28 L16 14 L26 28" fill="none" stroke="#0c1230" stroke-width="3.2" stroke-linejoin="round" stroke-linecap="round"/></svg>
                RaceDay
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (user != null && user.IsParticipant)
                    {
                        <li class="nav-item"><a class="nav-link@(Active("Home", "Events"))" asp-controller="Home" asp-action="Index">Events</a></li>
                        <li class="nav-item"><a class="nav-link@(Active("MyEnrolments"))" asp-controller="MyEnrolments" asp-action="Index">My enrolments</a></li>
                        <li class="nav-item"><a class="nav-link@(Active("MyResults"))" asp-controller="MyResults" asp-action="Index">My results</a></li>
                        <li class="nav-item"><a class="nav-link@(Active("Profile"))" asp-controller="Profile" asp-action="Index">Profile</a></li>
                    }
                    else if (user != null && user.IsOrganiser)
                    {
                        <li class="nav-item"><a class="nav-link@(Active("Dashboard"))" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link@(Active("ManageEvents"))" asp-controller="ManageEvents" asp-action="Index">Events</a></li>
                        <li class="nav-item"><a class="nav-link@(Active("ManageCategories"))" asp-controller="ManageCategories" asp-action="Index">Categories</a></li>
                        <li class="nav-item"><a class="nav-link@(Active("ManageEnrolments"))" asp-controller="ManageEnrolments" asp-action="Index">Enrolments</a></li>
                        <li class="nav-item"><a class="nav-link@(Active("ManageResults"))" asp-controller="ManageResults" asp-action="Index">Results</a></li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-2">
                    @if (user == null)
                    {
                        <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Log in</a>
                        <a class="btn btn-sm btn-signal" asp-controller="Account" asp-action="Register">Sign up</a>
                    }
                    else
                    {
                        <div class="dropdown">
                            <button class="btn rd-user dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (avatarUrl != null)
                                {
                                    <img class="avatar" src="@avatarUrl" alt="" />
                                }
                                else
                                {
                                    <span class="avatar" aria-hidden="true">@user.Initials</span>
                                }
                                <span>@user.FullName</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><span class="dropdown-item-text small text-muted">Signed in as @user.Role</span></li>
                                @if (user.IsParticipant)
                                {
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">Your profile</a></li>
                                }
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item">Log out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

<main>
    @RenderBody()
</main>

<footer class="rd-footer">
    <div class="container d-flex flex-wrap justify-content-between gap-2">
        <span>RaceDay. Race events, enrolments and results in one place.</span>
        <span>PROG6212 Part 3</span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
